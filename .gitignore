*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Editable-install artifacts left in-tree
*.pth

# Local run logs / generated outputs (kept under results/ when needed)
logs/*.log

